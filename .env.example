# Example configuration for Roku.
# Copy this file to .env and replace placeholder values before running live integrations.
# Leave optional override variables empty to keep the built-in defaults.
# Boolean values accept: true/false, 1/0, yes/no, on/off.

# OpenRouter settings.
# Required for `live-once`, `telegram-bot`, and `api-gateway`.
OPENROUTER_API_KEY=replace-with-openrouter-api-key
OPENROUTER_PRIMARY_MODEL=step-3.5-flash:free
OPENROUTER_FALLBACK_MODELS=deepseek-chat,gemini-2.0-flash
# Alias for OPENROUTER_PRIMARY_MODEL. Used only when OPENROUTER_PRIMARY_MODEL is empty.
OPENROUTER_MODEL=
# Optional request attribution headers.
OPENROUTER_APP_NAME=
OPENROUTER_SITE_URL=
# Override only if you proxy OpenRouter through another compatible endpoint.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# Provider guardrails.
OPENROUTER_MAX_CONTEXT_TOKENS=128000
OPENROUTER_COST_PER_1K_TOKENS_USD=0.0
OPENROUTER_MAX_REQUEST_COST_USD=1.0
OPENROUTER_MAX_LATENCY_MS=60000

# Local-first runtime storage.
# Strong orchestration state lives in SQLite; artifacts and reports live as local files.
ROKU_HOME=~/.roku
ROKU_STATE_DIR=~/.roku/state
ROKU_SQLITE_PATH=~/.roku/state/control-plane.db
ROKU_ARTIFACT_ROOT=~/.roku/artifacts
ROKU_EXPERIMENT_ROOT=~/.roku/experiments
ROKU_REPORT_ROOT=~/.roku/reports
ROKU_SKILL_ROOT=.roku/skills
ROKU_PROMPT_ARCHIVE_DIR=~/.roku/prompts
ROKU_MEMORY_SUMMARY_DIR=~/.roku/memory
ROKU_AUDIT_EXPORT_DIR=~/.roku/exports/audit
ROKU_CACHE_DIR=~/.roku/cache
ROKU_RUN_DIR=~/.roku/run

# Telegram bot settings.
# Required only for `telegram-bot` or `scripts/dev-services.sh start telegram-bot`.
TELOXIDE_TOKEN=
# Alias for TELOXIDE_TOKEN. Used only when TELOXIDE_TOKEN is empty.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_POLL_TIMEOUT_SECONDS=30
TELEGRAM_IDLE_BACKOFF_MS=500
TELEGRAM_POLL_ERROR_LOG_THRESHOLD=5
TELEGRAM_PROGRESS_NOTICES=false
TELEGRAM_INCLUDE_REQUEST_METADATA=false
TELEGRAM_SHOW_ATTACHMENTS=false

# HTTP API gateway settings.
ROKU_API_BIND_ADDR=127.0.0.1:8787
ROKU_API_JSON_LIMIT_BYTES=8192

# Logging.
ROKU_LOG_DIR=~/.roku/logs
ROKU_LOG_MAX_FILE_BYTES=8388608
ROKU_LOG_MAX_BACKUP_FILES=5
ROKU_LOG_STDERR=true

# Local dev-service script paths.
# Used only by scripts/dev-services.sh.
ROKU_DEV_SERVICE_LOG_DIR=
